GOOGLE_APPLICATION_CREDENTIALS=../seafood-api/serviceAccountKey.json
TOP_N=10
MIN_SIMILARITY=0.0
# Hybrid model weights (should sum ~1.0)
# W_CF has been reduced from 0.45 to 0.30 to make room for W_RECENCY.
W_CF=0.30
W_CONTENT=0.35
W_POP=0.20
W_RECENCY=0.15
# Half-life for purchase recency decay (days). A purchase this many days old
# gets half the recency score of a purchase made today. Default: 30.
# RECENCY_HALF_LIFE_DAYS=30
TRAIN_ON_STARTUP=true
SCHEDULE_DAILY_TRAINING=true
TRAINING_HOUR=2
PURCHASE_TRAINING_DELAY_SECONDS=120
INTERACTION_TRAINING_DELAY_SECONDS=600
