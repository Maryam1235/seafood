# ── ClickPesa credentials (from ClickPesa dashboard) ──────────────────────────
CLICKPESA_CLIENT_ID=your_client_id
CLICKPESA_API_KEY=your_api_key
# Checksum key from the dashboard. Required when Checksum Security is enabled —
# outgoing requests are signed (HMAC-SHA256) and webhook checksums are verified.
CLICKPESA_CHECKSUM_SECURITY=your_checksum_key
# NOTE: webhooks are also verified by re-querying ClickPesa's API, so no separate
# webhook header secret is needed.

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Path to the service-account JSON downloaded from the Firebase console
# (Project settings → Service accounts → Generate new private key, project testing-bc269).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Optional: Python FastAPI recommendation service.
# NestJS only notifies this service after recording purchase_history.
RECOMMENDATION_SERVICE_URL=http://localhost:8000
